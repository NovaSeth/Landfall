{
  "source": "T-MG-187 review r2 F1-F4: spellings of `task set <id> dispatched` and `review record` that the 2.7.2 parsing guard allowed. {L} is the launcher word ({LC} capitalized, {LU} upper case), {A} the arguments of the forged command, {BIN} the directory of the launcher, {TMP} a scratch directory, {N} the spelling's number. wrap: the command is wrapped that many times in sh -c. needs: programs that must exist (the spelling is skipped otherwise). optional: skipped when the shell could not reach the CLI (a shell without $'...').",
  "spellings": [
    { "id": "F1-if", "tpl": "if true; then {L} {A}; fi" },
    { "id": "F1-for", "tpl": "for i in 1; do {L} {A}; done" },
    { "id": "F1-bang", "tpl": "! {L} {A}" },
    { "id": "F1-backslash", "tpl": "l\\andfall {A}" },
    { "id": "F1-ansi-c", "tpl": "$'l\\x61ndfall' {A}", "optional": true },
    { "id": "F1-while", "tpl": "while true; do {L} {A}; break; done" },
    { "id": "F1-brace", "tpl": "{ {L} {A}; }" },
    { "id": "F1-subshell", "tpl": "( {L} {A} )" },
    { "id": "F1-case", "tpl": "case x in x) {L} {A};; esac" },
    { "id": "F1-quote-mix", "tpl": "\"l\"'and'fall {A}" },
    { "id": "F1-assign-command", "tpl": "X=1 command {L} {A}" },
    { "id": "F2-env-u", "tpl": "env -u X {L} {A}", "needs": ["env"] },
    { "id": "F2-nice", "tpl": "nice -n 5 {L} {A}", "needs": ["nice"] },
    { "id": "F2-timeout", "tpl": "timeout 20 {L} {A}", "needs": ["timeout"] },
    { "id": "F2-setsid", "tpl": "setsid {L} {A}", "needs": ["setsid"], "optional": true },
    { "id": "F2-stdbuf", "tpl": "stdbuf -o0 {L} {A}", "needs": ["stdbuf"] },
    { "id": "F2-find-exec", "tpl": "find . -maxdepth 0 -exec {L} {A} \\;", "needs": ["find"] },
    { "id": "F2-env-S", "tpl": "env -S \"{L} {A}\"", "needs": ["env"], "optional": true },
    { "id": "F2-nohup", "tpl": "nohup {L} {A}", "needs": ["nohup"] },
    { "id": "F2-exec", "tpl": "exec {L} {A}" },
    { "id": "F3-xargs", "tpl": "echo {A} | xargs {L}", "needs": ["xargs"] },
    { "id": "F3-sh-c-args", "tpl": "sh -c '{L} \"$@\"' sh {A}" },
    { "id": "F3-bash-c-dashdash", "tpl": "bash -c -- '{L} {A}'", "needs": ["bash"] },
    { "id": "F3-nested-4", "tpl": "{L} {A}", "wrap": 4 },
    { "id": "F3-printf-pipe-sh", "tpl": "printf '%s\\n' '{L} {A}' | sh" },
    { "id": "F3-eval", "tpl": "eval \"{L} {A}\"" },
    { "id": "F4-symlink", "tpl": "ln -s {BIN}/{L} {TMP}/lnk{N} && {TMP}/lnk{N} {A}", "needs": ["ln"] },
    { "id": "F4-mjs-name", "tpl": "{L}.mjs {A}" },
    { "id": "F4-case-capitalized", "tpl": "{LC} {A}", "needs": ["{LC}"] },
    { "id": "F4-case-upper", "tpl": "{LU} {A}", "needs": ["{LU}"] },
    { "id": "F4-variable", "tpl": "a={L}; $a {A}" },
    { "id": "F4-command-subst", "tpl": "$(echo {L}) {A}" }
  ]
}

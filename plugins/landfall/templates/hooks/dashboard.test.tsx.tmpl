test('unrouted new tasks fold into one backlog line; routed, blocked and held tasks stay as rows', async ($, on) => {
  const row = (n: number, o: object = {}) => ({ id: `T-TU-${n}`, kind: 'task', title: `t${n}`, status: 'new', class: null, owner: 'TU', lane: null, round: 0, ...o })
  const tasks = [
    ...Array.from({ length: 9 }, (_, i) => row(10 + i)),
    row(30, { status: 'planned', class: 'standard' }),
    row(31, { status: 'blocked', class: 'standard' }),
  ]
  const steps = [
    ...Array.from({ length: 9 }, (_, i) => ({ task: `T-TU-${10 + i}`, state: 'new, not routed', step: '', rules: [], kind: 'info' })),
    { task: 'T-TU-30', state: 'planned', step: '', rules: [], kind: 'info' },
    { task: 'T-TU-31', state: 'blocked: waits on review', step: '', rules: [], kind: 'blocked' },
  ]
  const w = world(on, { status: { ...STATUS, data: { ...STATUS.data, tasks, steps } }, runs: { ...RUNS, data: { runs: [] } } })
  w.agents.length = 0
  await $.session.start(SESSION)
  await w.clock.settle()
  const ui = await $.ui.mount(PANE)
  expect((await ui.find({ type: 'Text', text: /T-TU-30/ }))?.text).toBe('■ T-TU-30 std t30  waiting · planned')
  expect(await ui.find({ type: 'Text', text: /T-TU-31/ })).toBeDefined()
  expect(await ui.find({ type: 'Text', text: /T-TU-1[0-8]/ })).toBeUndefined()
  expect((await ui.find({ type: 'Text', text: /in backlog/ }))?.text).toBe('⏸ 9 in backlog ({{bin}} task list)')
  await ui.unmount()
})


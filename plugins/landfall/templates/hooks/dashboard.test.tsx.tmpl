// The dashboard pane and status line, drawn from a status envelope the test answers for the plugin's CLI, an agent the
// engine lists and an external run; nothing beneath the plugin but these hooks (`claude plugin test`).
import { expect, mock, test } from 'claude-code/testing'

import { celebrationFrame } from './dashboard'

const PLUGIN = '{{plugin}}'
const SESSION = { cwd: '/work', surface: 'terminal', isInteractive: true } as const
const PANE = {
  plugin: PLUGIN,
  component: 'Pane',
  requestId: '{{bin}}',
  surface: 'terminal',
  props: { title: '{{displayName}}', isFocused: false, bodyColumns: 96, placement: 'dock', scroll: { offset: 0, bodyRows: 30 }, view: {} },
} as const

const BAND = {
  plugin: PLUGIN,
  component: 'AbovePrompt',
  surface: 'terminal',
  props: { hasSurvey: false, isWorking: false, maxRows: 6, bodyColumns: 120, scroll: { offset: 0, bodyRows: 6 }, view: {} },
} as const

const STATUS = {
  cli: 1,
  command: 'status',
  ok: true,
  code: 0,
  exit: 'OK',
  data: {
    repo: '/work/petla',
    state: { status: 'active', dir: '/work/petla/.{{bin}}', linked: false },
    tier: { tier: 'L0', mode: 'shadow' },
    tasks: [
      { id: 'T-TU-1', kind: 'task', title: 'Login', status: 'implemented', class: 'critical', owner: 'TU', lane: null, round: 1 },
      { id: 'T-TU-2', kind: 'task', title: 'Docs', status: 'new', class: null, owner: 'TU', lane: null, round: 0 },
      { id: 'T-TU-3', kind: 'task', title: 'Old', status: 'done', class: 'trivial', owner: 'TU', lane: null, round: 0 },
    ],
    steps: [
      { task: 'T-TU-1', state: 'review r2 approved', step: 'merge origin/main into its branch and verify it again: `{{bin}} verify T-TU-1`; merge it and close it: `{{bin}} task done T-TU-1`', rules: ['REV-11', 'FLW-8'], kind: 'action' },
      { task: 'T-TU-2', state: 'new, not routed', step: 'classify it: `{{bin}} route T-TU-2 --paths <p,…> --loc <n>`', rules: ['FLW-3'], kind: 'action' },
    ],
    // a loop that ended (lib/loop/kind.mjs: exit DONE | STALLED | BUDGET, null while it runs)
    loop: { schema: 1, startedAt: '2026-10-22T09:00:00.000Z', ticks: 7, exit: 'DONE', exitAt: '2026-10-22T10:00:00.000Z', reason: null },
    leases: [{ id: 'l1', kind: 'heavy', task: 'T-TU-1', status: 'live' }],
  },
  errors: [],
}
// the run summaries as `runs list --json` prints them (lib/runs): a live one and one stopped by the orchestrator
const RUNS = {
  ...STATUS,
  command: 'runs list',
  data: {
    runs: [
      { runId: 'r1', status: 'running', provider: 'codex', role: 'reviewer', task: 'T-TU-1', elapsedMs: 300000, tokens: { input: 1000, output: 200, cached: 0 }, lastLine: 'reading the diff', outFile: '/work/petla/.{{bin}}/local/review/T-TU-1-r1.json', error: null },
      { runId: 'r2', status: 'stopped', provider: 'codex', role: 'implementer', task: 'T-TU-2', elapsedMs: 61000, tokens: null, lastLine: 'writing', outFile: null, error: 'stopped by the orchestrator' },
    ],
  },
}
const INACTIVE = { ...STATUS, data: { repo: '/work/other', state: { status: 'inactive', dir: null, linked: false }, tasks: [], steps: [], loop: null, leases: [] } }
const BLOCKED = { ...STATUS, data: { ...STATUS.data, steps: [...STATUS.data.steps.slice(0, 1), { task: 'T-TU-2', state: 'blocked: waiting for the API key', step: '', rules: [], kind: 'blocked' }] } }
const OVER = { ...STATUS, data: { ...STATUS.data, loop: { schema: 1, startedAt: '2026-10-22T09:00:00.000Z', ticks: 7, exit: 'BUDGET', exitAt: '2026-10-22T10:00:00.000Z', reason: null } } }
const IDLE = { ...STATUS, data: { ...STATUS.data, tasks: [], steps: [], leases: [] } }
const LOOPING = { ...STATUS, data: { ...STATUS.data, loop: { schema: 1, startedAt: '2026-10-22T10:00:00.000Z', ticks: 3, exit: null, exitAt: null, reason: null } } }

const answer = (doc: unknown) => ({ value: { exitCode: 0, stdout: JSON.stringify(doc), stderr: '', isStdoutTruncated: false, isStderrTruncated: false } })

function world(on: Parameters<Parameters<typeof test>[1]>[1], { status = STATUS, runs = RUNS, placed = true }: { status?: unknown; runs?: unknown; placed?: boolean } = {}) {
  const statuses: (string | undefined)[] = []
  const argvs: string[][] = []
  // the engine's agent list, which a test changes as agents start and end
  const agents: { id: string; description: string; type: string; status: string }[] = [{ id: 'a1', description: 'Review T-TU-1 round 2', type: '{{plugin}}:reviewer', status: 'running' }]
  // set by a test to make the CLI fail (killed at its timeout, not found)
  // `runsMs`: how long `runs list` takes to answer, on the test's clock (review r1 F1: a slow refresh)
  const cli = { fails: false, runsMs: 0 }
  on('process.run', async ($, e) => {
    argvs.push([...e.argv])
    if (cli.fails) return { deny: 'the child was killed at 8000 ms' }
    if (e.argv.includes('runs') && cli.runsMs > 0) await clock.sleep(cli.runsMs)
    return answer(e.argv.includes('runs') ? runs : status)
  })
  on('agent.list', () => ({ value: agents.map(a => ({ ...a })) }))
  on('command.register', () => ({ value: { command: 'dashboard' } }))
  on('ui.open', () => ({ value: placed ? { isPlaced: true } : { isPlaced: false, reason: 'the terminal is 100 columns wide; a pane opened unasked waits for 144' } }))
  on('ui.status', ($, e) => {
    statuses.push(e.text)
    return { value: undefined }
  })
  on('session.start', (_, e) => ({ cwd: e.cwd }))
  on('ui.render', ($, e) => {
    const { Text } = $.ui.resolve(e)
    return <Text>engine</Text>
  })
  const clock = mock.clock(on, { now: Date.parse('2026-10-22T10:05:00.000Z') })
  return { statuses, argvs, agents, cli, clock }
}

test('the pane says, from general to detail, the project, the tasks with their stage, the agents with role, task, round and time, the slots and the next step', async ($, on) => {
  const w = world(on)
  await $.session.start(SESSION)
  await w.clock.settle()
  expect(w.argvs.some(a => a.includes('status') && a.includes('--json'))).toBe(true)
  expect(w.argvs.some(a => a.includes('runs') && a.includes('list'))).toBe(true)

  const ui = await $.ui.mount(PANE)
  expect((await ui.find({ type: 'Text', text: /^petla/ }))?.text).toBe('petla · L0 (shadow) · loop done after 7 ticks')
  expect((await ui.find({ type: 'Text', text: /open · / }))?.text).toBe('2 open · 1 active · 0 planned · 1 new · 1 done')
  // the task being worked on first (an agent and a run name it), with its round, class and stage; the waiting one next; the closed one not at all
  expect((await ui.find({ type: 'Text', text: /T-TU-1 r1/ }))?.text).toBe('▶ T-TU-1 r1 crit Login  working · review r2 approved')
  expect(await ui.find({ type: 'Text', text: /T-TU-2/ })).toBeUndefined() // an unrouted new task is folded into the backlog line (T-MG-85)
  expect((await ui.find({ type: 'Text', text: /in backlog/ }))?.text).toBe('⏸ 1 in backlog ({{bin}} task list)')
  expect(await ui.find({ type: 'Text', text: /T-TU-3/ })).toBeUndefined()
  // the Claude subagent the engine lists and the external run, each with role, task, time and status
  expect((await ui.find({ type: 'Text', text: /● reviewer/ }))?.text).toBe('    ↳ ● reviewer     r2  00:00  running')
  expect((await ui.find({ type: 'Text', text: /codex reviewer/ }))?.text).toBe('    ↳ ● codex reviewer  05:00  running  → T-TU-1-r1.json  1.2k tok  reading the diff')
  // a stopped run is not live: the agent rows list only the agents and runs at work, with no fold line (intended change)
  expect(await ui.find({ type: 'Text', text: /codex implementer/ })).toBeUndefined()
  expect(await ui.find({ type: 'Text', text: /ended/ })).toBeUndefined()
  expect((await ui.find({ type: 'Text', text: /^SLOTS/ }))?.text).toBe('SLOTS heavy 1')
  expect((await ui.find({ type: 'Text', text: /^NEXT/ }))?.text).toBe('NEXT T-TU-1: {{bin}} verify T-TU-1')
  await ui.unmount()
  // the pane is placed: no status line doubles it
  expect(w.statuses).toEqual([undefined])
})

test('a spawned agent is a row with the task, round and output file of its prompt; its turn end closes the row with where the result landed', async ($, on) => {
  const w = world(on)
  on('agent.spawn', () => ({ model: 'sonnet', agentId: 'a2' }))
  on('turn.complete', (_, e) => ({ text: e.answer }))
  await $.session.start(SESSION)
  await w.clock.settle()
  await $.agent.spawn({ prompt: 'Review brief: /work/petla/.{{bin}}/tasks/T-TU-9/review-r2-brief.md … write the review JSON to /tmp/s/T-TU-9-review-r2.json', description: 'Re-review T-TU-9', subagentType: '{{plugin}}:reviewer' })
  await w.clock.advance(1_000)
  // the engine's list does not carry the new agent yet: a fresh spawn stays a running row
  let ui = await $.ui.mount(PANE)
  expect((await ui.find({ type: 'Text', text: /T-TU-9/ }))?.text).toBe('    ↳ ● reviewer     T-TU-9   r2  00:01  running  → T-TU-9-review-r2.json')
  await ui.unmount()
  // listed by the engine while it runs; its turn end closes the row even before the list drops it
  w.agents.push({ id: 'a2', description: 'Re-review T-TU-9', type: '{{plugin}}:reviewer', status: 'running' })
  await w.clock.advance(60_000)
  await $.turn.complete({ answer: 'DONE\nVerdict approved.\nReview: /tmp/s/T-TU-9-review-r2.json', durationMs: 61_000, isAborted: false, turnId: 't1', agentId: 'a2', reason: 'answer', usage: { input_tokens: 1200, output_tokens: 300, cache_read_input_tokens: 0, cache_creation_input_tokens: 0 } })
  await w.clock.advance(1_000)
  ui = await $.ui.mount(PANE)
  // an intended change: an ended agent is no row at all, not even for a minute, and no fold line stands for it
  expect(await ui.find({ type: 'Text', text: /T-TU-9/ })).toBeUndefined()
  expect(await ui.find({ type: 'Text', text: /ended/ })).toBeUndefined()
  await ui.unmount()
})


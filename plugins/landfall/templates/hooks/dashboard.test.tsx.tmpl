test('an inactive repository draws the project and the hint; a placed pane refreshes every 15 s', async ($, on) => {
  const w = world(on, { status: INACTIVE })
  await $.session.start(SESSION)
  await w.clock.settle()
  const ui = await $.ui.mount(PANE)
  expect((await ui.find({ type: 'Text', text: /other/ }))?.text).toBe('other')
  expect((await ui.find({ type: 'Text', text: /not active/ }))?.text).toMatch(/{{bin}} init/)
  await ui.unmount()
  const before = w.argvs.length
  await w.clock.advance(15_000)
  expect(w.argvs.length).toBeGreaterThan(before)
})

test('a pane that is not placed refreshes every 60 s, not every 15 s; a running loop says its tick', async ($, on) => {
  const w = world(on, { status: LOOPING, placed: false })
  await $.session.start(SESSION)
  await w.clock.settle()
  const after = w.argvs.length
  await w.clock.advance(15_000)
  expect(w.argvs.length).toBe(after)
  await w.clock.advance(45_000)
  expect(w.argvs.length).toBeGreaterThan(after)
  const ui = await $.ui.mount(PANE)
  expect((await ui.find({ type: 'Text', text: /^petla/ }))?.text).toBe('petla · L0 (shadow) · loop running · tick 3')
  await ui.unmount()
})

test('a CLI that does not answer leaves the last rows standing with the error on top', async ($, on) => {
  const w = world(on)
  await $.session.start(SESSION)
  await w.clock.settle()
  w.cli.fails = true
  await w.clock.advance(15_000)
  const ui = await $.ui.mount(PANE)
  expect((await ui.find({ type: 'Text', text: /did not answer/ }))?.text).toBe('! {{bin}} status did not answer: the rows are from the last answer')
  expect((await ui.find({ type: 'Text', text: /T-TU-1 r1/ }))?.text).toBe('▸ T-TU-1 r1 crit  review r2 approved')
  await ui.unmount()
  w.cli.fails = false
  await w.clock.advance(15_000)
  const again = await $.ui.mount(PANE)
  expect(await again.find({ type: 'Text', text: /did not answer/ })).toBeUndefined()
  await again.unmount()
})

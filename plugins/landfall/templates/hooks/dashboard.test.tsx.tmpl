  })
  const status = withTask({ status: 'implemented' })
  const w = world(on, { status, runs: quiet, placed: false })
  w.agents.length = 0
  await $.session.start(SESSION)
  await w.clock.settle()
  status.data.tasks[0].status = 'done'
  await w.clock.advance(65_000)
  expect(ticks).toBe(0)
})

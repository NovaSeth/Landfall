#!/bin/sh
# {{displayName}} pre-push gate. Generated by `{{bin}} gen apply`; edits survive regeneration (3-way merge).
# Enable once per clone: git config core.hooksPath .githooks
# Git passes "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin. The push is blocked when a pushed
# commit tracks a generated side file (*{{sideSuffix}}), when the secrets scan of a pushed range does not exit 0
# (every commit of it, also a secret added and removed again), or when a gate command fails; the scan runs first.
# Exit codes: 0 push allowed · 1 push blocked.
zero() { case "$1" in *[!0]*) return 1 ;; *) return 0 ;; esac; }
run_gate() {
  printf 'pre-push: gate %s\n' "$1" >&2
  sh -c "$2" </dev/null || { printf 'pre-push: gate %s failed; push blocked\n' "$1" >&2; return 1; }
}
# The commits a ref adds: after the remote's commit, or for a new branch (or a remote commit unknown here) every
# commit on no remote-tracking branch.
scan_range() {
  if zero "$2" || ! git cat-file -e "$2^{commit}" 2>/dev/null; then
    revs="$1 --not --remotes"
  else
    revs="$2..$1"
  fi
  {{cli}} secrets --range "$revs" </dev/null
}
blocked=0
pushed=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  zero "$local_sha" && continue # deleting a remote branch pushes no commit
  pushed=1
  side="$(git ls-tree -r -z --name-only "$local_sha" | tr '\0' '\n' | grep -e '{{sideSuffixRegex}}$')"
  if [ -n "$side" ]; then
    printf 'pre-push: %s tracks generated side files; merge each into its target, then git rm it:\n%s\n' "$local_ref" "$side" >&2
    blocked=1
  fi
  scan_range "$local_sha" "${remote_sha:-0}"
  rc=$?
  if [ "$rc" -ne 0 ]; then
    printf 'pre-push: the secrets scan of %s exited %s (1 findings, 8 the scan could not run, 127 the CLI was not found); push blocked\n' "$local_ref" "$rc" >&2
    blocked=1
  fi
done
[ "$blocked" -eq 0 ] || exit 1
[ "$pushed" -eq 1 ] || exit 0
{{#gates}}
run_gate {{nameShell}} {{cmdShell}} || exit 1
{{/gates}}
exit 0
